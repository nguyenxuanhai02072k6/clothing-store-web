generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String             @id
  name           String
  email          String             @unique
  password       String
  role           String // 'customer' | 'employee' | 'manager' | 'director' | 'accountant' | 'cskh' | 'cashier' | 'stocker'
  branch         String? // 'Chi nhánh Quận 1', 'Chi nhánh Thảo Điền'
  avatar         String?
  salary         Float? // Basic monthly salary in VND
  totalSpent     Float              @default(0) // Lifetime spent in VND
  phone          String?
  commissionRate Float?             @default(0.0) // Custom sales commission rate (e.g. 0.03 for 3%)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  
  attendanceLogs  AttendanceLog[]
  leaveRequests   LeaveRequest[]
  salaryRequests  SalaryRequest[]
  dailyReports    DailyReport[]
  payrollRecords  PayrollRecord[]
  shiftRequests   ShiftRequest[]
  reservations    OfficeReservation[]
  tasks           WorkspaceTask[]
  shiftSwapsFrom  ShiftSwapRequest[] @relation("ShiftSwapFrom")
  shiftSwapsTo    ShiftSwapRequest[] @relation("ShiftSwapTo")
}

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  createdAt DateTime @default(now())
}

model Product {
  id          String           @id
  name        String
  slug        String           @unique
  category    String
  price       Float
  oldPrice    Float?
  description String
  images      String // JSON serialized array: '["url1", "url2"]'
  rating      Float            @default(0)
  reviews     Int              @default(0)
  has3D       Boolean          @default(false)
  modelType   String? // 'bag' | 'glasses' | 'dress' | 'default'
  badges      String? // comma-separated e.g. 'New,Sale'
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  
  variants           ProductVariant[]
  reviewsList        ProductReview[]
  orderItems         OrderItem[]
  warehouseReceipts  WarehouseReceipt[]
  inventoryAuditLogs InventoryAuditLog[]
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String // S, M, L, XL
  color     String // White, Black, Beige...
  sku       String   @unique
  stock     Int      @default(0) // Global stock fallback
  createdAt DateTime @default(now())

  inventoryItems       InventoryItem[]
  orderItems           OrderItem[]
  inventoryTransactions InventoryTransaction[]
  stockReservations    StockReservation[]
}

model InventoryItem {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchName  String // 'Chi nhánh Quận 1' | 'Chi nhánh Thảo Điền'
  stock       Int            @default(0)
  createdAt   DateTime       @default(now())

  @@unique([variantId, branchName])
}

model StockReservation {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branchName  String
  quantity    Int
  sessionId   String
  status      String         // 'active' | 'completed' | 'expired' | 'cancelled'
  expiresAt   DateTime
  createdAt   DateTime       @default(now())

  @@index([variantId, branchName, status, expiresAt])
}

model Order {
  id              String   @id
  customerName    String
  customerPhone   String
  customerEmail   String?
  address         String
  total           Float
  discount        Float    @default(0)
  voucherCode     String?
  paymentMethod   String // 'cod', 'vnpay', 'bank_transfer', 'momo'
  status          String // 'pending', 'confirmed', 'shipping', 'completed', 'cancelled'
  channel         String   @default("web") // 'web', 'pos', 'tiktok', 'shopee'
  branch          String? // 'Chi nhánh Quận 1', 'Chi nhánh Thảo Điền'
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  items           OrderItem[]
  payments        PaymentTransaction[]
  cskhTickets     CSKHTicket[]
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  name        String
  price       Float
  quantity    Int
  size        String?
  color       String?
  imageUrl    String?
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Float
  method        String // 'vnpay', 'cod', 'pos_cash', 'pos_card', 'pos_transfer'
  status        String // 'pending', 'success', 'failed'
  transactionId String?  @unique // Bank/Gateway transaction reference
  bankCode      String?
  payDate       DateTime?
  createdAt     DateTime @default(now())
}

model AttendanceLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // 'YYYY-MM-DD'
  checkIn   String // 'HH:mm'
  checkOut  String? // 'HH:mm'
  status    String // 'present', 'late', 'absent'
  branch    String
  createdAt DateTime @default(now())
}

model LeaveRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'annual', 'sick', 'unpaid'
  startDate String
  endDate   String
  reason    String
  status    String   @default("pending") // 'pending', 'approved', 'rejected'
  createdAt DateTime @default(now())
}

model SalaryRequest {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSalary Float
  proposedSalary Float
  reason       String
  status       String   @default("pending") // 'pending', 'approved', 'rejected'
  createdAt    DateTime @default(now())
}

model DailyReport {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    String
  content   String
  metrics   String? // JSON serialized revenue, order count, etc.
  date      String // 'YYYY-MM-DD'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PayrollRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month       String // 'YYYY-MM'
  baseSalary  Float
  bonus       Float    @default(0)
  deductions  Float    @default(0)
  commission  Float    @default(0)
  netSalary   Float
  status      String   @default("pending") // 'pending', 'paid'
  paymentDate DateTime?
  createdAt   DateTime @default(now())
}

model ShiftRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String // 'YYYY-MM-DD'
  shiftType   String // 'morning', 'afternoon', 'evening', 'full'
  branch      String
  status      String   @default("pending") // 'pending', 'approved', 'rejected'
  createdAt   DateTime @default(now())
}

model ShiftSwapRequest {
  id              String   @id @default(uuid())
  fromUserId      String
  fromUser        User     @relation("ShiftSwapFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId        String
  toUser          User     @relation("ShiftSwapTo", fields: [toUserId], references: [id], onDelete: Cascade)
  fromDate        String
  fromShift       String
  toDate          String
  toShift         String
  branch          String
  reason          String
  status          String   @default("pending") // 'pending', 'approved', 'rejected'
  peerStatus      String   @default("pending") // 'pending', 'accepted', 'declined'
  createdAt       DateTime @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  category    String // 'rent', 'utilities', 'marketing', 'salary', 'other'
  branch      String?
  date        String // 'YYYY-MM-DD'
  createdById String?
  receiptUrl  String?
  createdAt   DateTime @default(now())
}

model RestockRecord {
  id          String   @id @default(uuid())
  productName String
  size        String
  color       String
  quantity    Int
  branch      String
  status      String   @default("pending") // 'pending', 'approved', 'rejected'
  requestedBy String
  approvedBy  String?
  createdAt   DateTime @default(now())
}

model Voucher {
  id          String    @id @default(uuid())
  code        String    @unique
  discount    Float // Percentage (e.g. 10 for 10%) or Fixed amount
  isPercent   Boolean   @default(true)
  minSpend    Float     @default(0)
  maxDiscount Float?
  usageLimit  Int       @default(100)
  usedCount   Int       @default(0)
  startDate   DateTime  @default(now())
  endDate     DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  authorId    String
  authorName  String
  targetRole  String   @default("all") // 'all', 'employee', 'manager', 'director'
  isUrgent    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model OfficeReservation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomName    String // 'Phòng họp sáng tạo A', 'Studio chụp Lookbook B'
  date        String // 'YYYY-MM-DD'
  startTime   String // '09:00'
  endTime     String // '11:00'
  purpose     String
  status      String   @default("confirmed") // 'confirmed', 'cancelled'
  createdAt   DateTime @default(now())
}

model WorkspaceTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  assignedTo  String
  user        User     @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  status      String   @default("todo") // 'todo', 'in_progress', 'review', 'done'
  priority    String   @default("medium") // 'low', 'medium', 'high', 'urgent'
  dueDate     String?
  createdAt   DateTime @default(now())
}

model WikiArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  category    String // 'Quy định', 'Hướng dẫn POS', 'Tiêu chuẩn trưng bày', 'CSKH'
  authorName  String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model CRMClient {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  email       String?
  tier        String   @default("Silver") // 'Silver', 'Gold', 'Diamond'
  points      Int      @default(0)
  totalSpent  Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
}

model CSKHTicket {
  id          String   @id @default(uuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  customerName String
  phone       String?
  category    String // 'Đổi size', 'Trả hàng lỗi', 'Khiếu nại dịch vụ', 'Hỏi giao hàng'
  description String
  status      String   @default("open") // 'open', 'in_progress', 'resolved', 'closed'
  priority    String   @default("medium") // 'low', 'medium', 'high'
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockTransfer {
  id          String   @id @default(uuid())
  productId   String
  size        String
  color       String
  quantity    Int
  fromBranch  String
  toBranch    String
  status      String   @default("pending") // 'pending', 'in_transit', 'received', 'cancelled'
  requestedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DamagedGood {
  id          String   @id @default(uuid())
  productId   String
  size        String
  color       String
  quantity    Int
  issue       String // 'Rách vải', 'Bung chỉ', 'Hỏng khóa', 'Vết bẩn không sạch'
  reportedBy  String
  branch      String
  status      String   @default("pending") // 'pending', 'repaired', 'liquidated', 'written_off'
  createdAt   DateTime @default(now())
}

model CashReconciliation {
  id          String   @id @default(uuid())
  branch      String
  date        String // 'YYYY-MM-DD'
  cashierName String
  expectedCash Float
  actualCash   Float
  difference   Float
  notes        String?
  status       String   @default("balanced") // 'balanced', 'shortage', 'excess'
  createdAt    DateTime @default(now())
}

model ChatSession {
  id            String        @id @default(uuid())
  customerId    String
  customerName  String
  customerEmail String?
  customerAvatar String?
  cskhId        String?
  cskhName      String?
  status        String        @default("waiting") // 'waiting', 'active', 'closed'
  lastMessage   String?
  unreadCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages      ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender    String // 'customer', 'cskh', 'system'
  senderName String
  text      String
  timestamp DateTime    @default(now())
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  rating    Int // 1 - 5
  comment   String
  images    String? // JSON string: '["url1"]'
  createdAt DateTime @default(now())
}

model InventoryTransaction {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type        String // 'in', 'out', 'transfer', 'adjustment'
  quantity    Int
  referenceId String?
  notes       String?
  createdAt   DateTime       @default(now())
}

model WarehouseReceipt {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  importPrice Float
  supplier    String
  createdById String
  createdAt   DateTime @default(now())
}

model InventoryAuditLog {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  action      String // 'create', 'update_price', 'update_stock', 'delete'
  oldValue    String?
  newValue    String?
  performedBy String
  createdAt   DateTime @default(now())
}
