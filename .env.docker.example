# ========================================================
# NOVYN WEAR - DOCKER ENVIRONMENT CONFIGURATION EXAMPLE
# ========================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Encryption Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET=novyn-wear-secure-docker-session-secret-change-me-in-production-2026

# Database Connection (Default: embedded SQLite with Docker volume)
DATABASE_URL=file:./database/seed.db

# Optional: Cloud PostgreSQL (Neon / Supabase / Self-hosted Postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/clothing_store?schema=public

# Optional: Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Facebook / Meta OAuth Credentials
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional: VNPay Payment Gateway
PAYMENT_MERCHANT_ID=NOVYN001
PAYMENT_HASH_SECRET=novyn-fashion-payment-secure-hash-secret-2026
PAYMENT_GATEWAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
