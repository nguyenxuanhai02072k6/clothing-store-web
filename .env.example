# ==============================================================================
# NOVYN E-COMMERCE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# HƯỚNG DẪN: Copy file này thành '.env' và điền giá trị cấu hình thực tế của bạn.
# TUYỆT ĐỐI KHÔNG commit file '.env' thật lên GitHub!
# ==============================================================================

# Database Connection
# SQLite: "file:./dev.db" (Development)
# PostgreSQL: "postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public" (Production recommended)
DATABASE_URL="file:./dev.db"

# Session Security (Bắt buộc tối thiểu 32 ký tự ngẫu nhiên trong môi trường production)
SESSION_SECRET="change-this-to-a-secure-random-32-char-secret-key-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# VNPay Payment Gateway Sandbox / Production
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:3000/api/checkout/vnpay-return"

# Transactional Email (Resend / SMTP)
RESEND_API_KEY=""
SYSTEM_FROM_EMAIL="onboarding@resend.dev"
CSKH_SUPPORT_EMAIL="support@novyn.vn"

# Google OAuth 2.0 Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook App Credentials (https://developers.facebook.com/apps)
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
